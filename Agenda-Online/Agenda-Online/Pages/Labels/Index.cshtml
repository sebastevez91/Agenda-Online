@page
@model Agenda_Online.Pages.Labels.IndexModel

<h2 class="my-4">Lista de Etiquetas</h2>

<p>
    <a class="btn btn-success mb-3" asp-page="Create">Agregar Etiqueta</a>
</p>

<table class="table table-hover shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>Nombre</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var etiqueta in Model.Label)
        {
            <tr>
                <td>@etiqueta.LabelName</td>
                <td>
                    <a class="btn btn-warning btn-sm" asp-page="Edit" asp-route-id="@etiqueta.LabelId">Editar</a> |
                    <a class="btn btn-danger btn-sm" asp-page="Delete" asp-route-id="@etiqueta.LabelId">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

